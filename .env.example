# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git — it is in `.gitignore`.
# NEVER share these values in chat, screenshots, or anywhere else.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-token-here

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here

# Gemini model — gemini-2.0-flash-exp is fast & free-tier friendly
GEMINI_MODEL=gemini-2.0-flash-exp

# Bot identity (cosmetic, used in /about)
BOT_NAME=SecureLife
BOT_USERNAME=securelife_bot

# Rate limiting — messages per user per hour
RATE_LIMIT_PER_HOUR=30

# Database path (SQLite)
DB_PATH=securelife.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Default language for new users: en or uz
DEFAULT_LANGUAGE=uz

# Optional: admin Telegram user IDs (comma-separated) for /stats command
ADMIN_USER_IDS=

# Optional: max input length to analyze (chars)
MAX_INPUT_LENGTH=4000

# Optional: proxy for Telegram API (and update polling).
# Use this if your network blocks api.telegram.org (e.g. some ISPs in
# Uzbekistan/Iran/Russia/China). Supports HTTP, HTTPS, and SOCKS5 proxies.
# Examples:
#   http://127.0.0.1:8080
#   http://user:pass@proxy.example.com:3128
#   socks5://127.0.0.1:1080
# For SOCKS5 you must also: pip install "httpx[socks]"
TELEGRAM_PROXY=
